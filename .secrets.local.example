# Local Meta/Instagram secrets. Copy this file to `.secrets.local` and fill in
# the real values locally. Never commit the real token file.

# Instagram API access token generated in Meta Developer / Instagram setup.
META_INSTAGRAM_ACCESS_TOKEN=


# Instagram account/user ID used by the publishing API.
META_IG_USER_ID=

# Facebook page connected to the Instagram account.
META_PAGE_ID=1070265356175884

# Meta app IDs are not secret, but keeping them here helps future setup.
META_APP_ID=
META_INSTAGRAM_APP_ID=
