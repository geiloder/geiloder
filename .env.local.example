# Supabase — https://supabase.com/dashboard/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Groq — https://console.groq.com/keys (100% free, no credit card)
GROQ_API_KEY=gsk_...

# Site URL (Vercel fills this automatically in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin auth — pick any secret string, used to set the admin cookie
ADMIN_SECRET=change-me-to-something-long-and-random

# Awin — https://ui.awin.com/awin-api
AWIN_API_TOKEN=
AWIN_PUBLISHER_ID=

# ADCELL — https://www.adcell.de/api
ADCELL_API_KEY=

# Open Food Facts — public read API, no key required
OPENFOODFACTS_QUERIES=protein bar,high protein pudding,whey protein,protein drink,creatine,esn,evo sports nutrition,barebells,ehrmann high protein
OPENFOODFACTS_PAGE_SIZE=30
OPENFOODFACTS_USER_AGENT=geiloder/0.1 (contact: hello@geiloder.de)
